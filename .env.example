# Ambiente de Configuração SIPP (Andrecito & SIPP Notes)

# --- Supabase: LEITURA (cliente) ---
# A anon key é pública (vai no bundle) — protegida por RLS (rode supabase_security.sql).
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anonima-supabase

# --- Supabase: ESCRITA (servidor /api/admin) ---
# A service_role IGNORA RLS e é SECRETA — só no servidor, nunca no cliente (sem VITE_).
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-secreta

# Senha de administrador validada no servidor para liberar escritas via /api/admin.
# Deve ser igual à senha digitada no login do Andrecito (default do gate: gs4607).
ADMIN_PASSWORD=gs4607

# Chave da API do Google Gemini — usada SOMENTE no servidor (função /api/gemini e
# no servidor de dev). SEM o prefixo VITE_, então NÃO é embutida no bundle do cliente.
# Em produção (Vercel): defina API_KEY em Settings → Environment Variables.
API_KEY=sua-chave-api-gemini

# (Opcional) Origens extras autorizadas a chamar /api/gemini, separadas por vírgula.
# A mesma origem do deploy já é permitida automaticamente. Ex.: https://meu-dominio.com
ALLOWED_ORIGINS=

# (Opcional) Rate limit do proxy de IA por IP. Defaults: 20 requisições / 60s.
GEMINI_RATE_LIMIT=20
GEMINI_RATE_WINDOW_SEC=60

# (Opcional) Rate limit GLOBAL via Upstash Redis. Se preenchidas, o limite passa a
# ser compartilhado entre todas as instâncias serverless; senão, usa limite em memória.
# Na Vercel, criar "Upstash for Redis" em Storage injeta estas envs automaticamente.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# (Opcional) Modelo Gemini usado em ambos os módulos de IA. Default: gemini-2.5-flash
VITE_GEMINI_MODEL=gemini-2.5-flash

# (Opcional) Senha(s) do gate de IA do Painel DEA, separadas por vírgula.
# AVISO: gate client-side não é segurança real; o valor fica visível no bundle.
VITE_DEA_AI_PASSWORD=gs4607,admin
